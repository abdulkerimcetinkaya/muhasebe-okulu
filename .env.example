# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=muhasebe-okulu
DB_USERNAME=your_username
DB_PASSWORD=your_secure_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:8080,http://localhost:63342

# ⚠️ IMPORTANT SECURITY NOTES:
# 1. Copy this file to .env and fill in real values
# 2. NEVER commit .env file to Git
# 3. Use strong passwords (min 12 characters, mixed case, numbers, symbols)
# 4. Change JWT_SECRET to a random 32+ character string
# 5. In production, use different values for each environment
