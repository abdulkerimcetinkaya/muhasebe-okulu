# MuhasebeOkulu Environment Configuration Template
# Copy this file to .env and fill in your actual values
# SECURITY: Never commit .env file to version control!

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/muhasebe-okulu
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Security Configuration
# IMPORTANT: Generate a strong, random secret key for production!
# You can use: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Application Configuration (Optional)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Production Deployment Notes:
# - Use strong, randomly generated passwords
# - Never use default/example values in production
# - Consider using secret management services (AWS Secrets Manager, Azure Key Vault, etc.)
# - Rotate secrets regularly
